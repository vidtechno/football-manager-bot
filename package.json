{
  "name": "football-manager-bot",
  "version": "1.0.0",
  "description": "Telegram Football Manager Bot",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "start": "node dist/src/index.js",
    "worker:bot-transfers": "node dist/src/jobs/runBotTransferWorkerCli.js",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts",
    "data:validate": "tsx src/data/validate-dataset.ts",
    "data:validate-legends": "tsx src/data/validate-legends.ts",
    "data:generate-seed": "tsx src/data/generate-seed-sql.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "grammy": "^1.45.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
