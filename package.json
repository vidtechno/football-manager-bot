{
  "name": "football-manager-bot",
  "version": "1.0.0",
  "description": "Telegram Football Manager Bot",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "worker:bot-transfers": "node dist/src/jobs/runBotTransferWorkerCli.js",
    "data:validate": "tsx src/data/validate-dataset.ts",
    "data:validate-legends": "tsx src/data/validate-legends.ts",
    "data:generate-seed": "tsx src/data/generate-seed-sql.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vercel/node": "^5.10.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
